#: musicbot/aliases.py:56
msgid "Error while loading aliases.\n\nProblem:\n  Your aliases files (aliases.json & example_aliases.json) are missing.\n\nSolution:\n  Replace the alias config file(s) or copy them from:\n    https://github.com/Just-Some-Bots/MusicBot/"
msgstr ""

#: musicbot/bot.py:709
msgid "Member is not voice-enabled and cannot use this command."
msgstr "這位成員沒有開啟語音，無法使用這個指令。"

#: musicbot/bot.py:717
msgid "You cannot use this command when not in the voice channel."
msgstr "你不在語音頻道裡，不能用這個指令。"

#: musicbot/bot.py:760
msgid "MusicBot does not have permission to Connect in channel:  `%(name)s`"
msgstr "MusicBot 沒有權限連進頻道 `%(name)s`"

#: musicbot/bot.py:769
msgid "MusicBot does not have permission to Speak in channel:  `%(name)s`"
msgstr "MusicBot 沒有權限在頻道 `%(name)s` 說話"

#: musicbot/bot.py:802
msgid "MusicBot could not connect to the channel.\nTry again later, or restart the bot if this continues."
msgstr "MusicBot 連不進這個頻道。\n請稍後再試，如果一直這樣就重啟機器人。"

#: musicbot/bot.py:826
msgid "MusicBot connection to voice was cancelled. This is odd. Maybe restart?"
msgstr "MusicBot 的語音連線被取消了，這不太正常，也許該重啟一下？"

#: musicbot/bot.py:837
msgid "MusicBot does not have permission to speak."
msgstr "MusicBot 沒有說話的權限。"

#: musicbot/bot.py:841
msgid "MusicBot could not request to speak."
msgstr "MusicBot 無法送出發言請求。"

#: musicbot/bot.py:1013
msgid "The bot is not in a voice channel.\nUse the summon command to bring the bot to your voice channel."
msgstr "阿北還在土城舍房裡。用 /summon 把他交保出來大聲唱歌！"

#: musicbot/bot.py:1025
msgid "Something is wrong, we didn't get the VoiceClient."
msgstr "有點不對勁，沒有取得 VoiceClient。"

#: musicbot/bot.py:1081
msgid "Skipping next song `%(title)s` as requester `%(user)s` is not in voice!"
msgstr "跳過下一首 `%(title)s`，因為點歌的 `%(user)s` 不在語音頻道裡！"

#: musicbot/bot.py:1099
msgid "%(mention)s - your song `%(title)s` is now playing in %(channel)s!"
msgstr "%(mention)s － 你點的 `%(title)s` 正在 %(channel)s 播放！"

#: musicbot/bot.py:1108
msgid "Now playing in %(channel)s: `%(title)s` added by %(author)s!"
msgstr "%(channel)s 正在播放：`%(title)s`（%(author)s 點的）"

#: musicbot/bot.py:1119
msgid "Now playing automatically added entry `%(title)s` in %(channel)s!"
msgstr "%(channel)s 正在播放自動加入的曲目 `%(title)s`"

#: musicbot/bot.py:1350
msgid "Skipping songs added by %(user)s as they are not in voice!"
msgstr "跳過 %(user)s 點的歌，因為人不在語音頻道裡！"

#: musicbot/bot.py:1572
msgid "Playback failed for song `%(song)s` due to an error:\n```\n%(error)s```"
msgstr "❌ `%(song)s` 播放失敗！YouTube 又在搞司法迫害：\n```\n%(error)s```"

#: musicbot/bot.py:1824
msgid "[Dev Bug] Tried sending an invalid response object."
msgstr ""

#: musicbot/bot.py:2175
msgid "Failed Discord API Login!\n\nProblem:\n  MusicBot could not log into Discord API.\n  Your Token may be incorrect or there may be an API outage.\n\nSolution:\n  Make sure you have the correct Token set in your config.\n  Check API status at the official site: discordstatus.com"
msgstr ""

#: musicbot/bot.py:2787
msgid "The requested song `%(subject)s` is blocked by the song block list."
msgstr "你點的 `%(subject)s` 被歌曲封鎖清單擋下了。"

#: musicbot/bot.py:2923
msgid "Reset the auto playlist queue by copying it back into player memory.\nThis command will be removed in a future version, replaced by the autoplaylist command(s)."
msgstr ""

#: musicbot/bot.py:2938
msgid "\\N{OK HAND SIGN}"
msgstr ""

#: musicbot/bot.py:2945
msgid "Show usage and description of a command, or list all available commands.\n"
msgstr "顯示某個指令的用法與說明，或列出所有可用指令。\n"

#: musicbot/bot.py:2976
msgid "**Aliases for this command:**\n"
msgstr "**這個指令的別名：**\n"

#: musicbot/bot.py:2979
msgid "`%(alias)s` alias of `%(command)s %(args)s`\n"
msgstr ""

#: musicbot/bot.py:3012
msgid "**Alias of command:**\n  `%(command)s`\n"
msgstr "**此為指令的別名：**\n  `%(command)s`\n"

#: musicbot/bot.py:3019
msgid "%(is_alias)s\n%(docs)s\n%(alias_list)s"
msgstr ""

#: musicbot/bot.py:3028
msgid "No such command"
msgstr "沒有這個指令。不要問，你會怕，去看 /help 的 SOP！"

#: musicbot/bot.py:3047
msgid "The list above shows only commands permitted for your use.\nFor a list of all commands, run: %(example_all)s\n"
msgstr "以上只列出你有權限使用的指令。\n要看全部指令請執行：%(example_all)s\n"

#: musicbot/bot.py:3053
msgid "**Commands by name:** *(without prefix)*\n```\n%(command_list)s\n```\n**Command Prefix:** %(prefix)s\n\nFor help with a particular command, run: %(example_command)s\n%(all_note)s"
msgstr "**指令一覽：** *(不含前綴)*\n```\n%(command_list)s\n```\n**指令前綴：** %(prefix)s\n\n要查詢個別指令的用法，請執行：%(example_command)s\n%(all_note)s"

#: musicbot/bot.py:3072
msgid "    Block a mentioned user."
msgstr ""

#: musicbot/bot.py:3075
msgid "    Unblock a mentioned user."
msgstr ""

#: musicbot/bot.py:3078
msgid "    Show the block status of a mentioned user."
msgstr ""

#: musicbot/bot.py:3082
msgid "Manage the users in the user block list.\nBlocked users are forbidden from using all bot commands.\n"
msgstr ""

#: musicbot/bot.py:3104
msgid "You must mention a user or provide their ID number."
msgstr "你必須標註一位使用者，或提供他的 ID。"

#: musicbot/bot.py:3109
msgid "Invalid sub-command given. Use `help blockuser` for usage examples."
msgstr ""

#: musicbot/bot.py:3120
msgid "MusicBot could not find the user(s) you specified."
msgstr "MusicBot 找不到你指定的使用者。"

#: musicbot/bot.py:3127
msgid "The owner cannot be added to the block list."
msgstr "擁有者不能被加入封鎖清單。"

#: musicbot/bot.py:3147
msgid "User block list is currently enabled."
msgstr "使用者封鎖清單目前為啟用。"

#: musicbot/bot.py:3149
msgid "User block list is currently disabled."
msgstr "使用者封鎖清單目前為停用。"

#: musicbot/bot.py:3157
msgid "Cannot add the users you listed, they are already added."
msgstr "無法加入你列出的使用者，他們已經在清單裡了。"

#: musicbot/bot.py:3166
msgid "%(number)s user(s) have been added to the block list.\n%(status)s"
msgstr "已將 %(number)s 位使用者加入封鎖清單。\n%(status)s"

#: musicbot/bot.py:3177
msgid "None of those users are in the blacklist."
msgstr ""

#: musicbot/bot.py:3182
msgid "User: `%(user)s` is not blocked.\n"
msgstr "使用者 `%(user)s` 未被封鎖。\n"

#: musicbot/bot.py:3184
msgid "User: `%(user)s` is blocked.\n"
msgstr "使用者 `%(user)s` 已被封鎖。\n"

#: musicbot/bot.py:3187
msgid "**Block list status:**\n%(status)s\n%(users)s"
msgstr "**封鎖清單狀態：**\n%(status)s\n%(users)s"

#: musicbot/bot.py:3197
msgid "%(number)s user(s) have been removed from the block list.\n%(status)s"
msgstr "已將 %(number)s 位使用者從封鎖清單移除。\n%(status)s"

#: musicbot/bot.py:3206
msgid "Manage a block list applied to song requests and extracted song data.\nA subject may be a song URL or a word or phrase found in the track title.\nIf subject is omitted, any currently playing track URL will be added instead.\n\nThe song block list matches loosely, but is case-sensitive.\nThis means adding 'Pie' will match 'cherry Pie' but not 'piecrust' in checks.\n"
msgstr ""

#: musicbot/bot.py:3234
msgid "You must provide a song subject if no song is currently playing."
msgstr "目前沒有在播歌，必須指定要封鎖的對象。"

#: musicbot/bot.py:3240
msgid "Invalid sub-command given. Use `help blocksong` for usage examples."
msgstr ""

#: musicbot/bot.py:3252
msgid "Subject `%(subject)s` is already in the song block list."
msgstr "`%(subject)s` 已經在歌曲封鎖清單裡了。"

#: musicbot/bot.py:3275
msgid "Added subject `%(subject)s` to the song block list.\n%(status)s"
msgstr "已把 `%(subject)s` 加進歌曲封鎖清單。\n%(status)s"

#: musicbot/bot.py:3284
msgid "The subject is not in the song block list and cannot be removed."
msgstr "這個項目不在歌曲封鎖清單裡，無法移除。"

#: musicbot/bot.py:3292
msgid "Subject `%(subject)s` has been removed from the block list.\n%(status)s"
msgstr "已把 `%(subject)s` 從封鎖清單移除。\n%(status)s"

#: musicbot/bot.py:3302
msgid "    Adds or removes the specified song or currently playing song to/from the current playlist.\n"
msgstr ""

#: musicbot/bot.py:3305
msgid "    Adds the entire queue to the guilds playlist.\n"
msgstr ""

#: musicbot/bot.py:3328
msgid "    Set a playlist as default for this guild and reloads the guild auto playlist.\n"
msgstr ""

#: musicbot/bot.py:3372
msgid "Invalid sub-command given. Use `help autoplaylist` for usage examples."
msgstr ""

#: musicbot/bot.py:3379
msgid "The supplied song link is invalid"
msgstr "提供的歌曲連結無效"

#: musicbot/bot.py:3385
msgid "The queue is empty. Add some songs with a play command!"
msgstr "歌單空空如也，怪怪的。趕快用 /play 塞幾首歌進來，該怎麼辦就怎麼辦！"

#: musicbot/bot.py:3396
msgid "All songs in the queue are already in the autoplaylist."
msgstr "隊列裡的歌全部都已經在自動播放清單裡了。"

#: musicbot/bot.py:3400
msgid "Added %(number)d songs to the autoplaylist."
msgstr "已加入 %(number)d 首歌到自動播放清單。"

#: musicbot/bot.py:3410
msgid "Added `%(url)s` to the autoplaylist."
msgstr "已把 `%(url)s` 加進自動播放清單。"

#: musicbot/bot.py:3413
msgid "This song is already in the autoplaylist."
msgstr "這首歌已經在自動播放清單裡了。"

#: musicbot/bot.py:3427
msgid "Removed `%(url)s` from the autoplaylist."
msgstr "已把 `%(url)s` 從自動播放清單移除。"

#: musicbot/bot.py:3430
msgid "This song is not yet in the autoplaylist."
msgstr "這首歌還不在自動播放清單裡。"

#: musicbot/bot.py:3439
msgid "Loaded a fresh copy of the playlist: `%(file)s`"
msgstr "已重新載入播放清單：`%(file)s`"

#: musicbot/bot.py:3464
msgid "You must provide a playlist filename."
msgstr "必須提供播放清單的檔名。"

#: musicbot/bot.py:3484
msgid "\nThis playlist is new, you must add songs to save it to disk!"
msgstr ""

#: musicbot/bot.py:3489
msgid "The playlist for this server has been updated to: `%(name)s`%(note)s"
msgstr "本伺服器的播放清單已更新為：`%(name)s`%(note)s"

#: musicbot/bot.py:3600
msgid "Generate an invite link that can be used to add this bot to another server."
msgstr "產生一個邀請連結，可以把這個機器人加到其他伺服器。"

#: musicbot/bot.py:3612
msgid "Click here to add me to a discord server:\n%(url)s"
msgstr "點這裡把我加進 Discord 伺服器：\n%(url)s"

#: musicbot/bot.py:3618
msgid "Toggle karaoke mode on or off. While enabled, only karaoke members may queue songs.\nGroups with BypassKaraokeMode permission control which members are Karaoke members.\n"
msgstr "開啟或關閉卡拉 OK 模式。開啟時只有卡拉 OK 成員可以點歌。\n擁有 BypassKaraokeMode 權限的群組決定誰算是卡拉 OK 成員。\n"

#: musicbot/bot.py:3630
msgid "\\N{OK HAND SIGN} Karaoke mode is now enabled."
msgstr ""

#: musicbot/bot.py:3632
msgid "\\N{OK HAND SIGN} Karaoke mode is now disabled."
msgstr ""

#: musicbot/bot.py:3655
msgid "You are not allowed to request playlists"
msgstr "你沒有權限點播放清單"

#: musicbot/bot.py:3663
msgid "Playlist has too many entries (%(songs)s but max is %(max)s)"
msgstr "播放清單曲目太多（%(songs)s 首，上限是 %(max)s 首）"

#: musicbot/bot.py:3674
msgid "The playlist entries will exceed your queue limit.\nThere are %(songs)s in the list, and %(queued)s already in queue.\nThe limit is %(max)s for your group."
msgstr "這個播放清單會讓你超過排隊上限。\n清單裡有 %(songs)s 首，你已經排了 %(queued)s 首。\n你所屬群組的上限是 %(max)s 首。"

#: musicbot/bot.py:3807
msgid "Bot was previously paused, resuming playback now."
msgstr "機器人先前是暫停狀態，現在恢復播放。"

#: musicbot/bot.py:3816
msgid "Add a song to be played in the queue. If no song is playing or paused, playback will be started.\n\nYou may supply a URL to a video or audio file or the URL of a service supported by yt-dlp.\nPlaylist links will be extracted into multiple links and added to the queue.\nIf you enter a non-URL, the input will be used as search criteria on YouTube and the first result played.\nMusicBot also supports Spotify URIs and URLs, but audio is fetched from YouTube regardless.\n"
msgstr "把一首歌加進播放隊列。如果目前沒有在播或已暫停，就會開始播放。\n\n你可以給影片或音訊檔的網址，或任何 yt-dlp 支援的服務網址。\n播放清單連結會被展開成多首並全部加進隊列。\n如果輸入的不是網址，就會拿去 YouTube 搜尋並播放第一筆結果。\nMusicBot 也支援 Spotify 的 URI 與網址，但音訊一律還是從 YouTube 抓。\n"

#: musicbot/bot.py:3855
msgid "Play command that shuffles playlist entries before adding them to the queue.\n"
msgstr "播放指令，但會先把播放清單的曲目打亂再加進隊列。\n"

#: musicbot/bot.py:3892
msgid "Shuffled playlist items into the queue from `%(request)s`"
msgstr "已把 `%(request)s` 的曲目打亂後加進隊列"

#: musicbot/bot.py:3899
msgid "A play command that adds the song as the next to play rather than last.\nRead help for the play command for information on supported inputs.\n"
msgstr "播放指令，但把歌插到「下一首」而不是隊列最後。\n支援的輸入格式請看 play 指令的說明。\n"

#: musicbot/bot.py:3934
msgid "A play command which skips any current song and plays immediately.\nRead help for the play command for information on supported inputs.\n"
msgstr "播放指令，會跳過目前這首直接播放新的。\n支援的輸入格式請看 play 指令的說明。\n"

#: musicbot/bot.py:3971
msgid "Restarts the current song at the given time.\nIf time starts with + or - seek will be relative to current playback time.\nTime should be given in seconds, fractional seconds are accepted.\nDue to codec specifics in ffmpeg, this may not be accurate.\n"
msgstr "把目前這首歌跳到指定時間點重新播放。\n時間前面加 + 或 - 就是相對於目前播放位置。\n時間以秒為單位，可以有小數。\n受 ffmpeg 編解碼特性影響，可能不會非常精準。\n"

#: musicbot/bot.py:3991
msgid "Cannot use seek if there is nothing playing."
msgstr "沒有在播東西，不能用 seek。"

#: musicbot/bot.py:3996
msgid "Cannot use seek on current track, it has an unknown duration."
msgstr "這首歌長度未知，不能用 seek。"

#: musicbot/bot.py:4002
msgid "Seeking is not supported for streams."
msgstr "串流不支援 seek。"

#: musicbot/bot.py:4012
msgid "Cannot use seek without a time to position playback."
msgstr "用 seek 必須指定要跳到的時間。"

#: musicbot/bot.py:4030
msgid "Could not convert `%(input)s` to a valid time in seconds."
msgstr "`%(input)s` 無法轉換成有效的秒數。"

#: musicbot/bot.py:4043
msgid "Cannot seek to `%(input)s` (`%(seconds)s` seconds) in the current track with a length of `%(progress)s / %(total)s`"
msgstr "無法跳到 `%(input)s`（`%(seconds)s` 秒），目前這首的長度是 `%(progress)s / %(total)s`"

#: musicbot/bot.py:4067
msgid "Seeking to time `%(input)s` (`%(seconds).2f` seconds) in the current song."
msgstr "跳到 `%(input)s`（`%(seconds).2f` 秒）。"

#: musicbot/bot.py:4079
msgid "Toggles playlist or song looping.\nIf no option is provided the current song will be repeated.\nIf no option is provided and the song is already repeating, repeating will be turned off.\n"
msgstr "切換整個隊列或單曲的循環播放。\n不給參數的話就是重複目前這首。\n不給參數且已經在重複時，就會關掉循環。\n"

#: musicbot/bot.py:4097
msgid "No songs are currently playing. Play something with a play command."
msgstr "現在沒有在播任何歌，用 play 指令點首歌吧。"

#: musicbot/bot.py:4104
msgid "Invalid sub-command. Use the command `help repeat` for usage examples."
msgstr "子指令無效。用 `help repeat` 看用法範例。"

#: musicbot/bot.py:4110 musicbot/bot.py:4147
msgid "Playlist is now repeating."
msgstr "隊列開始循環播放。"

#: musicbot/bot.py:4113 musicbot/bot.py:4140 musicbot/bot.py:4151
msgid "Playlist is no longer repeating."
msgstr "隊列已停止循環播放。"

#: musicbot/bot.py:4119 musicbot/bot.py:4128
msgid "Player will now loop the current song."
msgstr "開始單曲循環。"

#: musicbot/bot.py:4121 musicbot/bot.py:4135
msgid "Player will no longer loop the current song."
msgstr "已關閉單曲循環。"

#: musicbot/bot.py:4125
msgid "Player is already looping a song!"
msgstr "已經在單曲循環了！"

#: musicbot/bot.py:4142
msgid "The player is not currently looping."
msgstr "播放器目前沒有在循環。"

#: musicbot/bot.py:4153
msgid "Song is no longer repeating."
msgstr "這首歌已停止重複。"

#: musicbot/bot.py:4157
msgid "Song is now repeating."
msgstr "這首歌開始重複。"

#: musicbot/bot.py:4165
msgid "    Move song at position FROM to position TO.\n"
msgstr "    把第 FROM 位的歌移動到第 TO 位。\n"

#: musicbot/bot.py:4169
msgid "Swap existing songs in the queue using their position numbers.\nUse the queue command to find track position numbers.\n"
msgstr "用位置編號來調換隊列裡的歌。\n用 queue 指令可以查到每首歌的位置編號。\n"

#: musicbot/bot.py:4188
msgid "There are no songs queued. Play something with a play command."
msgstr "隊列裡沒有歌，用 play 指令點一首吧。"

#: musicbot/bot.py:4198 musicbot/bot.py:5346
msgid "Song positions must be integers!"
msgstr "位置編號必須是整數！"

#: musicbot/bot.py:4203
msgid "You gave a position outside the playlist size!"
msgstr "你給的位置超出隊列長度！"

#: musicbot/bot.py:4210
msgid "Successfully moved song from position %(from)s in queue to position %(to)s!"
msgstr "已把歌曲從第 %(from)s 位移到第 %(to)s 位！"

#: musicbot/bot.py:4298
msgid "This link contains a Playlist ID:\n`%(url)s`\n\nDo you want to queue the playlist too?"
msgstr "這個連結含有播放清單 ID：\n`%(url)s`\n\n要連整個播放清單一起加入嗎？"

#: musicbot/bot.py:4340
msgid "Local media playback is not enabled."
msgstr "本機媒體播放功能沒有啟用。"

#: musicbot/bot.py:4385
msgid "Spotify URL is invalid or not currently supported."
msgstr "Spotify 網址無效，或目前不支援。"

#: musicbot/bot.py:4389
msgid "Detected a Spotify URL, but Spotify is not enabled."
msgstr "偵測到 Spotify 網址，但 Spotify 功能沒有啟用。"

#: musicbot/bot.py:4399 musicbot/bot.py:4605
msgid "You have reached your enqueued song limit (%(max)s)"
msgstr "你排隊的歌已達上限（%(max)s 首）"

#: musicbot/bot.py:4405 musicbot/bot.py:4611 musicbot/bot.py:4708
msgid "Karaoke mode is enabled, please try again when its disabled!"
msgstr "卡拉 OK 模式開著，等關掉再試一次！"

#: musicbot/bot.py:3552 musicbot/bot.py:4421 musicbot/bot.py:4627
msgid "Failed to extract info due to error:\n%(raw_error)s"
msgstr "擷取資訊失敗，發生錯誤：\n%(raw_error)s"

#: musicbot/bot.py:4427
msgid "That video cannot be played. Try using the stream command."
msgstr "這部影片沒辦法播放，試試看用 stream 指令。"

#: musicbot/bot.py:4480
msgid "No songs were added, all songs were over max duration (%(max)s seconds)"
msgstr "沒有加入任何歌曲，全部都超過長度上限（%(max)s 秒）"

#: musicbot/bot.py:4485
msgid "Enqueued **%(number)s** songs to be played.\nPosition in queue: %(position)s"
msgstr "已加入 **%(number)s** 首歌到隊列。\n隊列位置：%(position)s"

#: musicbot/bot.py:4508
msgid "Song duration exceeds limit (%(length)s > %(max)s)"
msgstr "歌曲長度超過上限（%(length)s 秒 > %(max)s 秒）"

#: musicbot/bot.py:4520
msgid "Enqueued `%(track)s` to be played.\nPosition in queue: %(position)s"
