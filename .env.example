# Required on the first run. Never commit your real .env.
DISCORD_BOT_TOKEN=
OWNER_ID=
# Required while DASHBOARD_ENABLED=true (the default).
DASHBOARD_PUBLIC_URL=https://music.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional
DASHBOARD_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DEFAULT_LANGUAGE=en
TIME_ZONE=UTC
COMMAND_PREFIX=!
YTDLP_AUTO_UPDATE=false
# Linux bind-mount ownership; the bot must never run as root.
PUID=1000
PGID=1000
DASHBOARD_PORT=8080
